{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Break/Points chrome webview. The app's own commands each have a generated permission file, which is what makes them subject to the ACL, so every one of them has to be granted here or the chrome calls it and gets \"not allowed\" back. A new command needs a line here.",
  "windows": [
    "main"
  ],
  "webviews": [
    "chrome"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "allow-app-state",
    "allow-apply-viewports",
    "allow-audit-all",
    "allow-boot",
    "allow-breakpoint-sources",
    "allow-choose-project",
    "allow-choose-shot-dir",
    "allow-delete-profile",
    "allow-dropped-path",
    "allow-eval-js",
    "allow-inspect-chrome",
    "allow-inspect-panel",
    "allow-list-browsers",
    "allow-list-profiles",
    "allow-navigate",
    "allow-open-panel-in-browser",
    "allow-open-project",
    "allow-open-project-file",
    "allow-panel-console",
    "allow-panel-event",
    "allow-relayout",
    "allow-reload-all",
    "allow-reload-panel",
    "allow-rescan",
    "allow-reset-shot-dir",
    "allow-save-profile",
    "allow-scan-log",
    "allow-screenshot-panel",
    "allow-select-profile",
    "allow-set-bridge",
    "allow-set-follow-links",
    "allow-set-full-height",
    "allow-set-picking",
    "allow-set-preferences",
    "allow-set-scroll",
    "allow-set-scroll-sync",
    "allow-set-sheet-open",
    "allow-set-zoom-to-fit",
    "allow-stop-inspecting",
    "allow-take-reports",
    "allow-write-project-file"
  ]
}
